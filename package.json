{
  "name": "fixflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --name=fixflow_initial",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "switch:worker": "tsx src/server/switch/worker.ts",
    "test:persistence": "tsx --test tests/persistence/*.test.ts",
    "test:workflow": "tsx --test tests/workflow/*.test.ts",
    "test:ui": "tsx --test tests/ui/*.test.ts",
    "test": "npm run test:persistence && npm run test:workflow && npm run test:ui"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.2"
  }
}
